<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Soccer Overview"
 Width="1200" Height="842" MinWidth="820" MinHeight="590" WindowStartupLocation="CenterScreen"
 Background="#F2F5F2" Foreground="#14271F" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#EAF0EC"/><Setter Property="Foreground" Value="#163C2C"/>
   <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.82"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#50B58B"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.46"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/>
   <Setter Property="BorderBrush" Value="#DDE6DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,16"/></Style>
  <Style x:Key="Kicker" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#466556"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#BCCBC2"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Tile" Background="Transparent" Margin="0,2" Padding="10,8" CornerRadius="6">
     <ContentPresenter/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#F1F5F2"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#DAF1E4"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DrawingImage x:Key="ImageFallback"><DrawingImage.Drawing><DrawingGroup>
   <GeometryDrawing Brush="#DCE6E2" Geometry="M 0,0 H 48 V 48 H 0 Z"/>
   <GeometryDrawing Brush="#81998D" Geometry="M 24,8 L 36,12 L 35,25 Q 34,33 24,40 Q 14,33 13,25 L 12,12 Z"/>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <Style x:Key="Digit" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/>
   <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="32"/><Setter Property="Foreground" Value="#CCF580"/></Style>
  <Style x:Key="BoardCard" TargetType="Border"><Setter Property="Background" Value="#172D27"/><Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style x:Key="BoardText" TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F8F5"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="BoardCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#BCD0C5"/></Style>
  <DataTemplate x:Key="MatchRow">
   <Border Style="{StaticResource BoardCard}"><StackPanel>
    <TextBlock Text="{Binding Caption}" Style="{StaticResource BoardCaption}" HorizontalAlignment="Center"/>
    <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <DockPanel VerticalAlignment="Center" Margin="0,0,7,0"><Image DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,7,0"
       Source="{Binding LeftLogo,TargetNullValue={StaticResource ImageFallback},FallbackValue={StaticResource ImageFallback}}"/>
      <TextBlock Text="{Binding Left}" Style="{StaticResource BoardText}"/></DockPanel>
     <TextBlock Grid.Column="1" Text="{Binding Score}" Style="{StaticResource Digit}" FontSize="27" VerticalAlignment="Center"/>
     <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="7,0,0,0"><Image DockPanel.Dock="Right" Width="28" Height="28" Margin="7,0,0,0"
       Source="{Binding RightLogo,TargetNullValue={StaticResource ImageFallback},FallbackValue={StaticResource ImageFallback}}"/>
      <TextBlock Text="{Binding Right}" TextAlignment="Right" Style="{StaticResource BoardText}"/></DockPanel>
    </Grid></StackPanel></Border>
  </DataTemplate>
  <DataTemplate x:Key="PlayerRow">
   <Border Style="{StaticResource BoardCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <DockPanel><Image DockPanel.Dock="Left" Width="21" Height="21" Margin="0,0,7,0" Source="{Binding LeftLogo,TargetNullValue={StaticResource ImageFallback},FallbackValue={StaticResource ImageFallback}}"/>
      <TextBlock Text="{Binding Left}" Style="{StaticResource BoardText}"/></DockPanel>
     <DockPanel Margin="0,3,0,0"><Image DockPanel.Dock="Left" Width="17" Height="17" Margin="2,0,9,0" Source="{Binding RightLogo,TargetNullValue={StaticResource ImageFallback},FallbackValue={StaticResource ImageFallback}}"/>
      <TextBlock Text="{Binding Right}" Style="{StaticResource BoardCaption}" TextWrapping="Wrap"/></DockPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="TORE" Style="{StaticResource BoardCaption}"/><TextBlock Text="{Binding Goals}" Style="{StaticResource Digit}" FontSize="25"/></StackPanel>
    <StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock Text="ASSISTS" Style="{StaticResource BoardCaption}"/><TextBlock Text="{Binding Assists}" Style="{StaticResource Digit}" FontSize="25"/></StackPanel>
   </Grid></Border>
  </DataTemplate>
  <DataTemplate x:Key="NumberTile">
   <Border Style="{StaticResource BoardCard}" Margin="2"><StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource BoardCaption}"/>
    <TextBlock Text="{Binding Number}" Style="{StaticResource Digit}"/></StackPanel></Border>
  </DataTemplate>
  <ItemsPanelTemplate x:Key="ThreeColumns"><UniformGrid Columns="3"/></ItemsPanelTemplate>
 </Window.Resources>
 <DockPanel LastChildFill="True" Background="#F2F5F2">
  <Border DockPanel.Dock="Top" Background="#102E23" Padding="22,12"><DockPanel>
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="#C6F671" Width="31" Height="31" CornerRadius="7" Margin="0,0,10,0">
     <Path Stroke="#143729" StrokeThickness="2" Data="M4,18 L10,7 L16,18 M9,18 L15,7 L21,18" Stretch="Uniform" Margin="5"/>
    </Border>
    <TextBlock Text="Soccer Overview" Foreground="White" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <TextBlock x:Name="KeyStatus" Foreground="#D8EADD" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <PasswordBox x:Name="KeyBox" Width="148" Padding="6,4" VerticalContentAlignment="Center" AutomationProperties.Name="API-Football-Schlüssel" ToolTip="API-Football-Key für diese Sitzung eingeben"/>
    <Button x:Name="ApplyKey" Content="Key setzen" Margin="6,0,0,0" Background="#C6F671" Foreground="#19382B"/>

   </StackPanel>
  </DockPanel></Border>
  <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#D8E3DB" Background="#F8FAF8" Padding="20,7">
   <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="12" Foreground="#365344" AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#D8E3DB" BorderThickness="0,0,1,0" Padding="16,20,16,12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource Kicker}" Text="EXPLORER"/>
      <StackPanel Orientation="Horizontal" Margin="0,9,0,16">
       <Button x:Name="SearchTab" Content="Suche"/><Button x:Name="FavTab" Content="Favoriten"/>
      </StackPanel>
      <StackPanel x:Name="SearchFields">
       <TextBlock Text="Kategorie" FontSize="12" Margin="0,0,0,3"/>
       <ComboBox x:Name="TypeBox" AutomationProperties.Name="Kategorie" Padding="6,5" Margin="0,0,0,9" SelectedIndex="0"><ComboBoxItem Content="Club"/><ComboBoxItem Content="Spieler"/></ComboBox>
       <TextBlock x:Name="QueryLabel" Text="Name suchen · ab 4 Zeichen" FontSize="12" Margin="0,0,0,3"/>
       <TextBox x:Name="Query" AutomationProperties.Name="Suchbegriff" MaxLength="80" Margin="0,0,0,8"/>
       <Button x:Name="SearchButton" Content="Suchen" Margin="0" Background="#196342" Foreground="White"/>
      </StackPanel>
      <Border Height="1" Background="#E1E8E3" Margin="0,18,0,13"/>
      <TextBlock x:Name="ResultsTitle" Style="{StaticResource Kicker}" Margin="0,0,0,6"/>
     </StackPanel>
     <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Treffer oder Favoriten">
      <ListBox.ItemTemplate><DataTemplate><DockPanel>
       <Image DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,9,0" Source="{Binding Logo,TargetNullValue={StaticResource ImageFallback},FallbackValue={StaticResource ImageFallback}}"/>
       <StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
        <TextBlock FontSize="11" Foreground="#446555"><Run Text="{Binding Typ,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Land,Mode=OneWay}"/></TextBlock>
       </StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,22,16">
     <DockPanel Margin="0,0,0,10"><TextBlock Text="MATCH CENTER  /  SAISONÜBERSICHT" Style="{StaticResource Kicker}"/>
      <TextBlock x:Name="SourceTag" HorizontalAlignment="Right" Style="{StaticResource Kicker}"/>
     </DockPanel>
     <Border Background="#14382C" CornerRadius="12" Padding="18">
      <DockPanel><Border DockPanel.Dock="Left" Background="#F7FAF8" Width="76" Height="76" CornerRadius="8" Padding="5" Margin="0,0,15,0">
       <Image x:Name="Portrait" AutomationProperties.Name="Clublogo oder Spielerfoto" Source="{Binding Logo,TargetNullValue={StaticResource ImageFallback},FallbackValue={StaticResource ImageFallback}}"/>
      </Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Badge" Foreground="#C9EB98" FontSize="11" FontWeight="Bold"/>
       <TextBlock x:Name="Profile" Foreground="White" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="Meta" Foreground="#D3E1D8" TextWrapping="Wrap"/>
      </StackPanel></DockPanel>
     </Border>
     <DockPanel Margin="2,12,2,9">
      <Button x:Name="PinButton" DockPanel.Dock="Right" Content="Favorit speichern" Margin="5,0,0,0"/>
      <TextBlock Text="Saison" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="Season" AutomationProperties.Name="Verfügbare Saisons" Width="102" Padding="6,4" HorizontalAlignment="Left" IsEnabled="False"/>
     </DockPanel>
     <ItemsControl x:Name="Totals" ItemsPanel="{StaticResource ThreeColumns}" ItemTemplate="{StaticResource NumberTile}" Margin="0,0,0,9"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel>
      <TextBlock Text="01  /  ANZEIGETAFEL" Style="{StaticResource Kicker}"/>
      <TextBlock x:Name="SeriesTitle" FontWeight="SemiBold" FontSize="21" Margin="0,3,0,8"/>
      <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" Foreground="#466556"/>
      <ItemsControl x:Name="Boards"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="02  /  SAISONZAHLEN" Style="{StaticResource Kicker}"/>
      <TextBlock x:Name="BalanceTitle" FontWeight="SemiBold" FontSize="20" Margin="0,3,0,6"/>
      <ItemsControl x:Name="Balance" ItemsPanel="{StaticResource ThreeColumns}" ItemTemplate="{StaticResource NumberTile}"/>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
