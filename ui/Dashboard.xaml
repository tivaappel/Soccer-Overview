<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Soccer Overview"
 Width="1200" Height="842" MinWidth="820" MinHeight="590" WindowStartupLocation="CenterScreen"
 Background="#F2F5F2" Foreground="#14271F" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#EAF0EC"/><Setter Property="Foreground" Value="#163C2C"/>
   <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.82"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#50B58B"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.46"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/>
   <Setter Property="BorderBrush" Value="#DDE6DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,16"/></Style>
  <Style x:Key="Kicker" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#466556"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#BCCBC2"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Tile" Background="Transparent" Margin="0,2" Padding="10,8" CornerRadius="6">
     <ContentPresenter/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#F1F5F2"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#DAF1E4"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Count" TargetType="TextBlock"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <DockPanel LastChildFill="True" Background="#F2F5F2">
  <Border DockPanel.Dock="Top" Background="#102E23" Padding="22,12"><DockPanel>
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="#C6F671" Width="31" Height="31" CornerRadius="7" Margin="0,0,10,0">
     <Path Stroke="#143729" StrokeThickness="2" Data="M4,18 L10,7 L16,18 M9,18 L15,7 L21,18" Stretch="Uniform" Margin="5"/>
    </Border>
    <TextBlock Text="Soccer Overview" Foreground="White" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <TextBlock x:Name="KeyStatus" Foreground="#D8EADD" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <PasswordBox x:Name="KeyBox" Width="148" Padding="6,4" VerticalContentAlignment="Center" AutomationProperties.Name="API-Football-Schlüssel" ToolTip="API-Football-Key für diese Sitzung eingeben"/>
    <Button x:Name="ApplyKey" Content="Key setzen" Margin="6,0,0,0" Background="#C6F671" Foreground="#19382B"/>

   </StackPanel>
  </DockPanel></Border>
  <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#D8E3DB" Background="#F8FAF8" Padding="20,7">
   <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="12" Foreground="#365344" AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#D8E3DB" BorderThickness="0,0,1,0" Padding="16,20,16,12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource Kicker}" Text="EXPLORER"/>
      <StackPanel Orientation="Horizontal" Margin="0,9,0,16">
       <Button x:Name="SearchTab" Content="Suche"/><Button x:Name="FavTab" Content="Favoriten"/>
      </StackPanel>
      <StackPanel x:Name="SearchFields">
       <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Kategorie" FontSize="12" Margin="0,0,0,3"/>
         <ComboBox x:Name="TypeBox" AutomationProperties.Name="Kategorie" Padding="6,5" SelectedIndex="0"><ComboBoxItem Content="Club"/><ComboBoxItem Content="Spieler"/></ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Saison" FontSize="12" Margin="0,0,0,3"/><TextBox x:Name="Season" AutomationProperties.Name="Saison" MaxLength="4"/></StackPanel>
       </Grid>
       <TextBlock x:Name="QueryLabel" Text="Suchbegriff" FontSize="12" Margin="0,0,0,3"/>
       <TextBox x:Name="Query" AutomationProperties.Name="Suchbegriff" MaxLength="80" Margin="0,0,0,8"/>
       <Button x:Name="SearchButton" Content="Suchen" Margin="0" Background="#196342" Foreground="White"/>
      </StackPanel>
      <Border Height="1" Background="#E1E8E3" Margin="0,18,0,13"/>
      <TextBlock x:Name="ResultsTitle" Style="{StaticResource Kicker}" Margin="0,0,0,6"/>
     </StackPanel>
     <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Treffer oder Favoriten">
      <ListBox.ItemTemplate><DataTemplate><StackPanel>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
       <TextBlock FontSize="11" Foreground="#446555"><Run Text="{Binding Typ, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Land, Mode=OneWay}"/></TextBlock>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,22,16">
     <DockPanel Margin="0,0,0,10"><TextBlock Text="ANALYSE  /  SAISONÜBERSICHT" Style="{StaticResource Kicker}"/>
      <TextBlock x:Name="SourceTag" HorizontalAlignment="Right" Style="{StaticResource Kicker}"/>
     </DockPanel>
     <Border CornerRadius="12" Background="#133D2E" ClipToBounds="True" Padding="21,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.33*"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="Badge" Foreground="#C6F671" FontWeight="Bold" FontSize="11"/>
        <TextBlock x:Name="Profile" Foreground="White" FontSize="33" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2"/>
        <TextBlock x:Name="Meta" Foreground="#D0E6D8" TextWrapping="Wrap" FontSize="13"/>
       </StackPanel>
       <Viewbox Grid.Column="1" MaxWidth="170" MaxHeight="84" HorizontalAlignment="Right" Opacity="0.88">
        <Canvas Width="166" Height="82"><Rectangle Width="160" Height="76" Canvas.Left="3" Canvas.Top="3" RadiusX="2" RadiusY="2" Stroke="#609879"/>
         <Path Stroke="#609879" Data="M83,3 V79 M3,18 H24 V64 H3 M163,18 H142 V64 H163"/>
         <Ellipse Width="26" Height="26" Canvas.Left="70" Canvas.Top="28" Stroke="#609879"/>
         <Path Stroke="#CAEE83" StrokeDashArray="3 3" Data="M37,58 L78,20 L118,46 L151,36"/>
         <Ellipse Fill="#C6F671" Width="7" Height="7" Canvas.Left="34" Canvas.Top="55"/>
         <Ellipse Fill="#C6F671" Width="7" Height="7" Canvas.Left="75" Canvas.Top="17"/>
         <Ellipse Fill="#C6F671" Width="7" Height="7" Canvas.Left="115" Canvas.Top="43"/>
        </Canvas></Viewbox>
      </Grid>
     </Border>
     <UniformGrid Columns="3" Margin="0,12,0,12">
      <Border Style="{StaticResource Card}" Margin="0,0,5,0"><StackPanel><TextBlock x:Name="K1" Style="{StaticResource Kicker}"/><TextBlock x:Name="V1" Style="{StaticResource Count}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock x:Name="K2" Style="{StaticResource Kicker}"/><TextBlock x:Name="V2" Style="{StaticResource Count}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="5,0,0,0"><StackPanel><TextBlock x:Name="K3" Style="{StaticResource Kicker}"/><TextBlock x:Name="V3" Style="{StaticResource Count}"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="01   /   VERGLEICH" Style="{StaticResource Kicker}"/>
       <TextBlock x:Name="SeriesTitle" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,6"/>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,6" x:Name="Legend">
        <Ellipse Fill="#1D7850" Width="9" Height="9" Margin="0,0,5,0"/><TextBlock x:Name="LegendA" FontSize="12"/>
        <Ellipse Fill="#5D7EB3" Width="9" Height="9" Margin="16,0,5,0"/><TextBlock x:Name="LegendB" FontSize="12"/>
       </StackPanel>
       <StackPanel x:Name="SeriesPanel"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel><DockPanel>
       <Button DockPanel.Dock="Right" x:Name="PinButton" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0" Content="Favorit speichern"/>
       <StackPanel><TextBlock Text="02   /   BILANZ" Style="{StaticResource Kicker}"/>
        <TextBlock x:Name="BalanceTitle" FontSize="20" FontWeight="SemiBold" Margin="0,2"/>
       </StackPanel>
      </DockPanel><StackPanel x:Name="BalancePanel" Margin="0,6,0,0"/></StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
